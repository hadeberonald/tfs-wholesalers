# --- Ladysmith branch (whatsapp-bot-branch2) ---
# All vars here are the _2-suffixed counterparts of whatsapp-bot's vars.
# This lets both bots run in the same Render service/process without
# colliding — see config/db.js for why a shared/unsuffixed Mongo URI would
# be unsafe.

# --- Meta / WhatsApp Cloud API (Ladysmith's own WABA/App) ---
WHATSAPP_TOKEN_2=your_temporary_or_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID_2=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID_2=your_waba_id

# Any string you choose — must match what you enter in Meta's webhook
# config for Ladysmith's App
VERIFY_TOKEN_2=choose_a_random_secret_string

# Optional — only set if Ladysmith needs a different Graph API version
# than Dundee. Falls back to GRAPH_API_VERSION, then "v20.0".
GRAPH_API_VERSION_2=

# --- Server (only used if running this folder standalone) ---
PORT_2=3001

# --- MongoDB — Ladysmith's OWN database, must be different from Dundee's ---
WHATSAPP_MONGODB_URI_2=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/whatsapp-bot-ladysmith

# --- Human handoff — Ladysmith's own agent numbers ---
ORDERS_AGENT_NUMBER_2=27000000001
SUPPORT_AGENT_NUMBER_2=27000000002

ANALYTICS_API_KEY_2=change_me_to_a_new_random_secret

# --- Optional: only set these if Ladysmith's Meta price card differs
#     from Dundee's; otherwise Dundee's WA_RATE_* values are reused.
# WA_RATE_MARKETING_2=
# WA_RATE_UTILITY_2=
# WA_RATE_SERVICE_2=
# WA_RATE_AUTHENTICATION_2=
# WA_RATE_CURRENCY_2=
